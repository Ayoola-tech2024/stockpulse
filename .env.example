# Shopify App Credentials (from Shopify Dev Dashboard -> StockPulse)
SHOPIFY_API_KEY=your_client_id_here
SHOPIFY_API_SECRET=your_client_secret_here
SHOPIFY_APP_URL=https://stockpulse.dev
SCOPES=read_products,read_inventory

# PostgreSQL Connection String (Neon / Supabase / Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/stockpulse?schema=public"

# Resend Transactional Email API
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=alerts@yourdomain.com

# Optional: Set to "true" in development/staging to create test Shopify charges
SHOPIFY_BILLING_TEST_MODE=true
