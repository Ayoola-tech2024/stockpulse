// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id                String    @id @default(uuid())
  shop              String    @unique
  plan              String    @default("free") // "free" | "growth"
  planActivatedAt   DateTime?
  subscriptionId    String?
  emailSubject      String    @default("Good news! {{product_title}} is back in stock")
  senderName        String    @default("StockPulse Alerts")
  buttonText        String    @default("Notify Me When Available")
  buttonColor       String    @default("#008060")
  monthlyAlertsUsed Int       @default(0)
  quotaResetAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model WaitlistSubscriber {
  id            String    @id @default(uuid())
  shop          String
  productId     String
  variantId     String
  productTitle  String
  variantTitle  String?
  productHandle String?
  variantPrice  Float?
  email         String
  status        String    @default("pending") // "pending" | "notified" | "cancelled"
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([shop, variantId, status])
  @@index([shop, email])
}

model NotificationLog {
  id           String   @id @default(uuid())
  shop         String
  subscriberId String
  variantId    String
  email        String
  status       String   // "delivered" | "failed"
  errorMessage String?
  sentAt       DateTime @default(now())

  @@index([shop, sentAt])
}

model InventoryLevelState {
  id              String   @id @default(uuid())
  shop            String
  inventoryItemId String
  locationId      String
  available       Int
  updatedAt       DateTime @updatedAt

  @@unique([shop, inventoryItemId, locationId])
}
